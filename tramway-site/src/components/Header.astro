---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="shell">
		<p class="eyebrow">Cable transport field guide</p>
		<nav>
			<h2><a href="/">{SITE_TITLE}</a></h2>
			<div class="internal-links" aria-label="Primary">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/systems">Systems</HeaderLink>
				<HeaderLink href="/about">Taxonomy</HeaderLink>
			</div>
		</nav>
	</div>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--sand) 92%, white 8%);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
	}
	.shell {
		width: min(1100px, 92vw);
		margin: 0 auto;
		padding: 0.7rem 0 0.2rem;
	}
	.eyebrow {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--steel);
	}
	h2,
	h2 a {
		margin: 0;
		font-size: 1.2rem;
		text-decoration: none;
		color: var(--ink);
		font-family: var(--font-display);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0 0.7rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.internal-links a {
		color: var(--ink);
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		font-size: 0.95rem;
	}
	.internal-links a:hover,
	.internal-links a.active {
		background: color-mix(in srgb, var(--sky) 14%, white 86%);
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
		}
		.internal-links {
			flex-wrap: wrap;
		}
	}
</style>
